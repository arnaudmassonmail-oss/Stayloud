PORT=8787
DB_FILE=./data/music-radar.sqlite
REFRESH_CRON=*/30 * * * *

# ---------------- FREE-FIRST ----------------
# GDELT + Google News RSS need no API key.
NEWS_MONTHS=3

# MusicBrainz is free for non-commercial use and requires <= 1 request/sec.
# See README for the policy.

# Live feeds: add public RSS or iCalendar (.ics) feeds from venues,
# promoters, festivals or ticketing sites you trust.
#
# Example:
# LIVE_FEEDS_JSON=[{"name":"Ma Machine du Moulin Rouge","url":"https://example.com/calendar.ics","format":"ics"},{"name":"Venue RSS","url":"https://example.com/events.xml","format":"rss"}]
LIVE_FEEDS_JSON=[]

# Optional providers. The app works without them.
# SONGKICK_API_KEY=
# TICKETMASTER_API_KEY=
# BANDSINTOWN_APP_ID=

# Concerts: optional APIs. If not configured, STAYLOUD also tries free public event pages
# discovered through Google News RSS and JSON-LD event data.
# BANDSINTOWN_APP_ID=
# SONGKICK_API_KEY=
# TICKETMASTER_API_KEY=

# Optional AI verification agent. If both are set, each ambiguous concert
# candidate is sent to the model with its collected evidence; the model can
# reject contradictions or false artist associations. The deterministic
# verifier remains active even without these variables.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional image search API. If set, STAYLOUD uses Brave Image Search for richer thumbnails.
# BRAVE_SEARCH_API_KEY=


# ---------------- D1 — comptes + groupes ----------------
# Cloudflare account identifier (not the D1 database UUID)
CLOUDFLARE_ACCOUNT_ID=
# D1 database UUID
CLOUDFLARE_D1_DATABASE_ID=
# Cloudflare API token with D1 Read + D1 Write permissions
CLOUDFLARE_API_TOKEN=

# Account recovery / password reset
# Public URL used in reset links. Example: https://stayloud-xxxx.onrender.com
APP_PUBLIC_URL=
# Resend HTTP API credentials for password-reset emails
RESEND_API_KEY=
EMAIL_FROM=
